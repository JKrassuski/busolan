# Copie pra .env e preenche com os valores reais. Nada aqui funciona sem isso.

# Porta local do servidor
PORT=3000

# Postgres (histórico de conversa, pedidos, transbordos)
DATABASE_URL=postgres://busolan:busolan@localhost:5432/busolan

# Anthropic (Claude) - https://console.anthropic.com
ANTHROPIC_API_KEY=
# Confira o id do modelo atual na documentação da Anthropic antes de ir pra produção
ANTHROPIC_MODEL=claude-sonnet-5

# WhatsApp Cloud API (Meta) - https://developers.facebook.com/apps
# Token do app/sistema (permanente, não o temporário de 24h)
WHATSAPP_TOKEN=
# ID do número de telefone configurado no WhatsApp Business
WHATSAPP_PHONE_NUMBER_ID=
# String que você escolhe e cadastra no painel da Meta ao configurar o webhook
WHATSAPP_VERIFY_TOKEN=

# Opcional: notifica o vendedor num canal do Slack quando a IA transborda a conversa
SLACK_WEBHOOK_URL=
